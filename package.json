{
  "name": "@guardhq/sanitizer",
  "version": "2.0.0",
  "description": "Tiny text sanitizer that's really just a bunch of libraries in a trenchcoat.",
  "type": "module",
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check:package": "attw --pack .",
    "typecheck": "tsc",
    "prepublishOnly": "yarn typecheck && yarn build && yarn check:package"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guardhq/sanitizer.git"
  },
  "keywords": [
    "sanitize",
    "sanitizer",
    "text",
    "string",
    "unicode",
    "ascii",
    "accents",
    "diacritics",
    "transliterate",
    "normalize"
  ],
  "license": "MIT",
  "author": "Aniket (github.com/aniket091)",
  "homepage": "https://github.com/guardhq/sanitizer#readme",
  "bugs": {
    "url": "https://github.com/guardhq/sanitizer/issues"
  },
  "dependencies": {
    "latinize": "^0.4.1",
    "remove-accents": "^0.4.2",
    "unidecode": "^0.1.8",
    "unorm": "^1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/latinize": "^0.2.18",
    "@types/node": "^22.0.0",
    "@types/unidecode": "^1.1.0",
    "@types/unorm": "^1.3.31",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22"
}
